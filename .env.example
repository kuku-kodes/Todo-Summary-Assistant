# Backend Environment Variables (for .env in backend directory, or configure directly in application.properties)
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SPRING_DATASOURCE_USERNAME=your_database_username_here
SPRING_DATASOURCE_PASSWORD=your_database_password_here


# Frontend Environment Variables (for .env in frontend directory, if you move API_BASE_URL) REACT_APP_BACKEND_API_URL=http://localhost:8080/api 